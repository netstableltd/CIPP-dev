      "New-CippReportAlertBox",
      "New-CippReportBullets",
      "New-CippReportHeading",
      "New-CippReportInfoBox",
      "New-CippReportNote",
      "New-CippReportPage",
      "New-CippReportParagraph",
      "New-CippReportTable",
      "New-ExoRequest",
      "New-GraphGetRequest",
      "New-GraphPOSTRequest",
      "Set-CIPPMailboxPermission",
      "Write-LogMessage"
    ],
    "frontend": [
      "src/api/ApiCall",
      "src/components/CippAddons/CippAddonGuideUpload",
      "src/components/CippAddons/CippAddonPdfCard",
      "src/components/CippAddons/CippAddonStepResults",
      "src/components/CippCards/CippPageCard",
      "src/components/CippComponents/CippFormComponent",
      "src/components/CippComponents/CippFormDomainSelector",
      "src/components/CippComponents/CippFormUserSelector",
      "src/hooks/use-settings",
      "src/layouts/index"
    ]
