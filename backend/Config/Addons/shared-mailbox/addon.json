{
  "schema": 1,
  "id": "shared-mailbox",
  "name": "Shared mailbox",
  "version": "1.0.0",
  "description": "Sets up a shared mailbox the way the customer chooses: a PDF of the choices (access, sending, Outlook, sent items, signature, address book, who can email it, size) with what each means and our recommendation, then creates or updates the mailbox with all of them, and a PDF for the team on adding and using it.",
  "author": "Netstable",
  "category": "Standard process",
  "cipp": {
    "minVersion": "11.2.0",
    "testedWith": [
      "11.2.1"
    ]
  },
  "menu": [
    {
      "title": "Shared mailbox",
      "path": "/addons/shared-mailbox",
      "permissions": [
        "Exchange.Mailbox.*"
      ],
      "placement": "Community Additions",
      "preferredPlacement": "Email & Exchange > Administration"
    }
  ],
  "endpoints": [
    "ExecSharedMailboxCustomerPdf",
    "ExecSharedMailboxSetup",
    "ExecSharedMailboxSummaryPdf",
    "ListSharedMailboxSetup"
  ],
  "guides": [
    {
      "key": "sending",
      "title": "Sending from the shared mailbox",
      "what": "Your own step-by-step guide with screenshots (a Word document), added to the end of the \"your shared mailbox is ready\" PDF."
    }
  ],
  "dependsOn": {
    "functions": [
      "ConvertFrom-CIPPDocxGuide",
      "ConvertTo-CippReportPdf",
      "Get-CIPPAddonGuide",
